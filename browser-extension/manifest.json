{
  "manifest_version": 3,
  "name": "TraceCart — Opt-in Product Research Companion",
  "version": "0.2.1",
  "description": "Manual capture or explicitly queued, site-permission-gated product research via a local loopback broker; no cookies, accounts or checkout.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "alarms",
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Capture current product for TraceCart",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "companion_worker.mjs",
    "type": "module"
  }
}
